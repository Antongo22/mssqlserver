{
  "name": "mssql-studio-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build": "esbuild editor-entry.js --bundle --minify --outfile=public/editor.js && esbuild diagram-entry.js --bundle --minify --outfile=public/diagram.js && cp node_modules/elkjs/lib/elk-worker.min.js public/elk-worker.min.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "elkjs": "0.12.0",
    "express": "^5.1.0",
    "mssql": "^12.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "0.18.13"
  }
}
